<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:gravity="center"
    android:padding="24dp">

    <!-- Логотип и название -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="60dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPIRA X"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="обход блокировок"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:letterSpacing="0.05"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Основная кнопка с тенью и анимацией -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayRoblox"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="ИГРАТЬ В ROBLOX"
        android:textSize="18sp"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF3B82F6"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="32dp"
        app:icon="@drawable/ic_play_arrow"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF"
        android:stateListAnimator="@animator/button_state_list_anim"
        android:elevation="8dp"
        android:layout_marginBottom="24dp" />

    <!-- Статус -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Готов к запуску"
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:fontFamily="sans-serif-medium"
        android:alpha="0.9" />

</LinearLayout>